{
  "name": "@hexscout",
  "version": "27.0.0",
  "description": "A Scouting App/Member Management system written by Team 3197 Hexhounds",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "frontend": "pnpm --filter @hexscout/frontend run",
    "frontend:dev": "pnpm --filter @hexscout/frontend dev",
    "frontend:build": "pnpm --filter @hexscout/frontend build",
    "frontend:start": "pnpm --filter @hexscout/frontend start",
    "backend": "pnpm --filter @hexscout/backend run",
    "backend:dev": "pnpm --filter @hexscout/backend dev",
    "backend:build": "pnpm --filter @hexscout/backend build",
    "backend:start": "pnpm --filter @hexscout/backend start",
    "dev": "concurrently -n \"FE,BE\" -c \"bgBlue.bold,bgGreen.bold\" \"pnpm frontend:dev \" \"pnpm backend:dev\"",
    "build": "concurrently -n \"FE,BE\" -c \"bgBlue.bold,bgGreen.bold\" \"pnpm frontend:build \" \"pnpm backend:build\"",
    "start": "concurrently -n \"FE,BE\" -c \"bgBlue.bold,bgGreen.bold\" \"pnpm frontend:start \" \"pnpm backend:start\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node -e \"process.exit(0)\"",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,svelte}": "eslint",
    "*.{js,jsx,ts,tsx,svelte,json,css,md,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "Scouting App"
  ],
  "author": "team3197",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22",
    "pnpm": "10.11.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
